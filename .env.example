DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-your-local-mysql-password
DB_NAME=darling_app
DB_SSL=false
JWT_SECRET=replace-with-a-unique-random-value-of-at-least-32-characters
GEMINI_API_KEY=replace-with-your-gemini-api-key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-random-password-of-at-least-16-characters

DB_CONNECTION_LIMIT=10
MAX_REQUEST_BODY=32mb
# Optional: comma-separated origins if you host the frontend separately.
CORS_ORIGINS=
